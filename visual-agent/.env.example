# Copy to .env and adjust.

# vLLM OpenAI-compatible endpoint (see scripts/serve_vllm.sh)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
MODEL_NAME=Qwen/Qwen3-VL-32B-Instruct-FP8

# Sampling
TEMPERATURE=0.0

# Browser (computer-use)
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800
HEADLESS=true          # set false to watch the agent drive the browser
# CHROMIUM_EXECUTABLE=/usr/bin/chromium   # optional: use a system browser
#                                         # instead of `playwright install chromium`

# Agent loop
MAX_STEPS=15           # hard cap on tool-use steps per task
MAX_SCREENSHOTS=3      # how many recent screenshots stay in model context
MAX_IMAGE_EDGE=1280    # uploaded images are downscaled to this max edge

# Where per-run step screenshots are written
RUNS_DIR=runs
