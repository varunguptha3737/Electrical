# Copy to .env and adjust.

# vLLM OpenAI-compatible endpoint (see scripts/serve_vllm.sh)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
MODEL_NAME=Qwen/Qwen3-VL-32B-Instruct-FP8

# Sampling
TEMPERATURE=0.0

# Browser (computer-use)
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800
HEADLESS=true          # set false to watch the agent drive the browser
# CHROMIUM_EXECUTABLE=/usr/bin/chromium   # optional: use a system browser
#                                         # instead of `playwright install chromium`

# Agent loop
MAX_STEPS=15           # hard cap on tool-use steps per task
MAX_SCREENSHOTS=3      # how many recent screenshots stay in model context
MAX_IMAGE_EDGE=1280    # uploaded images are downscaled to this max edge
AGENT_VISION_MODE=hybrid   # hybrid = numbered elements on screenshots (efficient)
                           # pixels = raw screenshots + coordinate clicks only
COMPUTER_MODE=browser      # what computer-use controls: browser | desktop
                           # (desktop = whole OS screen; pip install -e ".[desktop]")

# Voice mode (pip install -e ".[voice]")
STT_BACKEND=whisper        # whisper (faster-whisper, multilingual) | moonshine (tiny, EN)
WHISPER_MODEL=large-v3-turbo   # use "small" if STT must run on the laptop CPU
WHISPER_DEVICE=auto        # auto | cuda | cpu
VOICE_NARRATION=true       # speak short progress lines during computer-use tasks

# Where per-run step screenshots are written
RUNS_DIR=runs

# Long-term memory (markdown vault, Obsidian-compatible)
MEMORY_ENABLED=true
MEMORY_DIR=memory      # point at an existing Obsidian vault if you have one
AUTO_MEMORY=true       # auto-save durable facts learned in conversations
